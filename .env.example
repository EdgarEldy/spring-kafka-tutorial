# Copy this file to .env and fill in real values. .env is gitignored on purpose:
# it is the only place actual secrets and machine specific names should live,
# never docker-compose.yml or any file committed to the repository.

# JDBC URL of the Postgres instance to use. If you are reusing an existing
# Postgres container instead of adding a dedicated one to this compose file,
# point the host at that container's name or address.
DB_URL=jdbc:postgresql://your-postgres-host:5432/spring_kafka_tutorial
DB_USERNAME=spring_kafka_tutorial
DB_PASSWORD=changeme

# Only needed if you reuse an existing Postgres container reachable through an
# external Docker network, see the "external_network" entry in docker-compose.yml.
POSTGRES_NETWORK_NAME=your-external-network-name
